{
  "name": "mana-platform",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "منصة نَما — Full-stack (Backend + Frontend + WebSocket) على سيرفر واحد (VPS)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "lint": "eslint server client/src",
    "lint:fix": "eslint server client/src --fix",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sanitize-html": "^2.14.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "vite": "^6.0.5"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
