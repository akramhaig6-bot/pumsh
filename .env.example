# ============================================================
# إعدادات منصة نَما — كل شيء يعمل على نفس السيرفر
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================================

# المنفذ الذي يعمل عليه السيرفر (API + الواجهة + WebSocket في نفس المنفذ)
PORT=8080
NODE_ENV=production

# عنوان القاعدة العامة للموقع (يستخدم في روابط الاستعادة وإشعارات البريد)
PUBLIC_URL=http://localhost:8080

# المفتاح السري لتوقيع/تشفير الجلسات والكوكيز (غيّره لقيمة عشوائية طويلة)
SECRET=change-me-to-a-long-random-secret

# مدة الجلسة (بالدقائق): جمود + مدة مطلقة
SESSION_IDLE_MINUTES=30
SESSION_MAX_MINUTES=720

# حماية الدخول
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_CAPTCHA_AFTER=3

# ---------- البريد الإلكتروني (اختياري لكنه إلزامي لإرسال روابط الاستعادة) ----------
# none | smtp   — إذا كان none: روابط الاستعادة تُسجَّل في السجل فقط (وضع تطوير)
MAIL_MODE=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="منصة نَما <no-reply@example.com>"

# الحد الأقصى للملفات (ميغابايت) — يطابق الإعداد المبدئي في اللوحة
MAX_FILE_MB=5

# ---------- الأدمن الأول (يُنشأ تلقائياً عند أول تشغيل إذا لم يوجد أدمن) ----------
ADMIN_NAME="مدير المنصة"
ADMIN_EMAIL=admin@nama.local
ADMIN_PASSWORD=Admin@12345   # غيّرها فوراً — النظام سيلزم أولئك الموجودين به بتغييرها
