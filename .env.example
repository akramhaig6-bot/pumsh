# ============================================================
# منصة نَما — إعدادات البيئة
#
# انسخ هذا الملف إلى .env ثم عدّل القيم:
#     cp .env.example .env
#
# ملاحظة: كل القيم المتعلقة بالنطاق تُقرأ من هنا حصراً.
# لا يوجد أي نطاق ثابت مكتوب في الكود.
# ============================================================

# ---------- التشغيل ----------
# development | production
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# level | info | warn | error
# في production تُطبع الأسطر بصيغة JSON (تصلح للتجميع)، وفي development نص مقروء.
LOG_LEVEL=info

# ---------- الأسرار (إلزامية في production) ----------
# ولّد قيمتين مختلفتين بـ:  node server/config.js --gen-secret
# الخادم يرفض الإقلاع في production إن كانت القيمة قصيرة أو مطابقة للافتراضية
# أو إن تطابقت القيمتان.
SESSION_SECRET=
CSRF_SECRET=

# ---------- المسارات ----------
# مجلد البيانات (قاعدة SQLite + المرفقات). افتراضياً <مجلد المشروع>/data
DATA_DIR=
# مسار قاعدة البيانات. افتراضياً $DATA_DIR/mana.db
DB_PATH=
# مجلد المرفقات والوسائط. افتراضياً $DATA_DIR/uploads
UPLOAD_DIR=

# ---------- العنوان العام ----------
# يُستخدم في روابط البريد (استعادة كلمة المرور) وكأصل مسموح في CORS.
# اتركه فارغاً في التطوير ليُشتق من رأس Host.
PUBLIC_URL=

# ---------- CORS ----------
# الأصول المسموح لها بالاتصال بالـ API، مفصولة بفواصل.
# في production هذا هو المصدر الوحيد المسموح — لا يوجد أي نطاق افتراضي.
# مثال: ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# اختيارية ومتوقفة افتراضياً. لا تفعّلها إلا إن كنت تعرف سبب ذلك:
# تسمح لأي أصل ينتهي باللاحقة المحددة، وهي ثغرة معروفة إن كانت اللاحقة عامة.
# مثال (خطير): CORS_ORIGIN_SUFFIXES=.vercel.app
CORS_ORIGIN_SUFFIXES=

# ---------- الوكيل العكسي ----------
# عدد قفزات الوكيل الموثوقة أمام التطبيق.
# 0 (الافتراضي) = لا ثقة بـ X-Forwarded-For إطلاقاً.
# عند استخدام nginx من deployment/nginx.conf اضبطها على 1.
# تحذير: ضبطها على قيمة أكبر من عدد القفزات الحقيقية يعيد فتح ثغرة تدوير
# العنوان لتجاوز حدود المعدل.
TRUST_PROXY_HOPS=0

# ---------- الجلسات ----------
SESSION_IDLE_MINUTES=30
SESSION_MAX_MINUTES=720
# [M16] أقصى عدد جلسات متزامنة للمستخدم الواحد — الأقدم يُلغى عند التجاوز
MAX_SESSIONS_PER_USER=5

# ---------- حماية الدخول ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_CAPTCHA_AFTER=3
# [C5] نافذة التلاشي: بعد هذه المدة بلا محاولات فاشلة يُصفَّر العدّاد تلقائياً،
# فلا يستطيع أحد حجب حساب غيره نهائياً.
LOGIN_FAIL_DECAY_MINUTES=30

# ---------- حدود المعدل ----------
RATE_LIMIT_GENERAL=400
RATE_LIMIT_AUTH=20
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_CLICK=30

# ---------- المرفقات ----------
MAX_FILE_MB=5
MAX_FILES_PER_REQUEST=8

# ---------- البريد ----------
# console | smtp
# في production يُرفض الإقلاع إن لم يكن smtp — وإلا ستُسجَّل روابط استعادة
# كلمة المرور في سجل الخادم (وهو مكافئ لتسريب الحسابات).
MAIL_MODE=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="منصة نَما <no-reply@example.com>"

# أسماء SMTP_* القديمة ما زالت تُقرأ كاحتياط، لكن يُفضَّل MAIL_*.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------- المشرف الأول ----------
# يُنشأ فقط عند أول إقلاع ولا يوجد مشرف في القاعدة.
# لا توجد بيانات اعتماد افتراضية في الكود: إن تركت هذين الحقلين فارغين
# فلن يُنشأ أي مشرف، وستظهر رسالة تحذير في السجل.
# يُنشأ بـ must_change=1 فيُجبر على تغيير كلمة المرور قبل أي إجراء.
ADMIN_NAME="مدير المنصة"
ADMIN_EMAIL=
ADMIN_PASSWORD=
